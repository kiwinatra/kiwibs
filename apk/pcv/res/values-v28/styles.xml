        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:colorEdgeEffect">@color/gray40</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="colorAccent">@color/button_blue_light</item>
        <item name="colorControlHighlight">@color/gray80</item>
        <item name="colorPrimary">@color/button_blue_light</item>
        <item name="colorPrimaryDark">@color/button_blue_dark</item>
    </style>
    <style name="Base.V28.Theme.AppCompat" parent="@style/Base.V26.Theme.AppCompat">
